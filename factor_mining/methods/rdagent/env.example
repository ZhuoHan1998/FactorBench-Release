# Copy to <repo root>/.env and fill in. Used by the RD-Agent loop
# (factor_mining.methods.rdagent.loop) and the AlphaAgent loop
# (factor_mining.methods.alphaagent.run).
# NOTE: the KCL endpoint only accepts requests from the university network/VPN.

# --- LLM (OpenAI-compatible endpoint) ---
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
OPENAI_API_BASE=https://api.ai.create.kcl.ac.uk/v1
OPENAI_API_KEY=sk-...

# Default model policy: free tier only (arc:nexus = Qwen3.8-27B, medium
# thinking; arc:lite/arc:nano are the same weights with less thinking).
# arc:apex / arc:apex_pro (paid GLM-5.2) deliberately not used for now.
CHAT_MODEL=openai/arc:nexus
# AlphaAgent's Idea/Factor agents use a separate reasoning model; its adapter
# strips the openai/ prefix automatically (its fork predates LiteLLM).
REASONING_MODEL=openai/arc:nexus
EMBEDDING_MODEL=openai/arc:embed

# Endpoints without JSON-schema response support may need:
# ENABLE_RESPONSE_SCHEMA=False

# --- Optional overrides (the loop drivers set sensible defaults for the rest) ---
# QLIB_FACTOR_EVOLVING_N=10          # RD-Agent Co-STEER evolution rounds
# FACTOR_CoSTEER_FILE_BASED_EXECUTION_TIMEOUT=3600
