# Copy to <repo root>/.env and fill in. Loaded by factor_mining.methods.rdagent.loop.
# NOTE: the KCL endpoint only accepts requests from the university network/VPN.

# --- LLM (OpenAI-compatible endpoint via LiteLLM) ---
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
CHAT_MODEL=openai/arc:nano
OPENAI_API_BASE=https://api.ai.create.kcl.ac.uk/v1
OPENAI_API_KEY=sk-...

# RD-Agent's Co-STEER RAG requires an embedding model. If the endpoint above
# does not serve embeddings, point these at one that does:
EMBEDDING_MODEL=openai/text-embedding-3-small
# LITELLM_PROXY_API_BASE=...   # only if embeddings live on a different host
# LITELLM_PROXY_API_KEY=...

# Endpoints without JSON-schema response support may need:
# ENABLE_RESPONSE_SCHEMA=False

# --- Optional overrides (loop.py sets sensible defaults for everything else) ---
# QLIB_FACTOR_EVOLVING_N=10          # Co-STEER evolution rounds per factor task
# FACTOR_CoSTEER_FILE_BASED_EXECUTION_TIMEOUT=3600
